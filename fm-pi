#!/bin/bash
set -eo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
python3 "$root/patch_pi.py" >&2
port=19761
server_pid=""
if ! curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
  fm serve --host 127.0.0.1 --port "$port" >"$root/fm-server.log" 2>&1 &
  server_pid=$!
  trap 'kill "$server_pid" 2>/dev/null || true' EXIT
  for _ in {1..50}; do
    if curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then break; fi
    if ! kill -0 "$server_pid" 2>/dev/null; then cat "$root/fm-server.log" >&2; exit 1; fi
    sleep 0.1
  done
fi
if ! curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
  echo "Apple FM server failed to start; see $root/fm-server.log" >&2
  exit 1
fi
export PI_CODING_AGENT_DIR="$root/pi-config"
prompt_args=(--system-prompt 'You are a coding assistant. Inspect relevant files, make focused changes, run appropriate checks, and report results and uncertainty concisely.')
args=()
for arg in "$@"; do
  case "$arg" in
    --standard-prompt) prompt_args=() ;;
    --system-prompt|--system-prompt=*) prompt_args=(); args+=("$arg") ;;
    *) args+=("$arg") ;;
  esac
done
"$root/pi/node_modules/.bin/pi" --offline --no-skills --model apple-fm/system "${prompt_args[@]}" "${args[@]}"
